div
  style(type="text/css"): include:stylus index.styl
  script(type="@plotdb/block"): include:lsc index.ls
  div(plug="body")
    .m-edit.has-tips.manual(ld="error-root")
      .grid(ld="grid")
        .head(ld="head")
          .cell
          .cell.cps-hover-host(ld-each="option")
            .option-wrap
              .clickable(ld="label")
              i.i-close.text-sm.ml-1.cps-hover-reveal.cps-remove(ld="remove-option")
        .body.cps-hover-host(ld-each="entry")
          .cell.entry-header
            .entry-wrap
              .flex-grow-1.clickable(ld="label")
              i.i-close.text-sm.ml-1.cps-hover-reveal.cps-remove(ld="remove-entry")
          .cell(ld-each="option"): .check(ld="check"): i.i-check
      .cps-ctrl: .mt-2.d-flex.g-2
        .clickable.rounded-sm.bg-dark.cps-add.px-2.py-1(
        ld="add-entry",style="font-size:0.875rem",t="new entry")
        .clickable.rounded-sm.bg-dark.cps-add.px-2.py-1(
        ld="add-option",style="font-size:0.875rem",t="new option")
    .m-view: div(ld="content",style="white-space:pre-wrap")
